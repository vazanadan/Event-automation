# BigQuery Configuration
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json
BIGQUERY_PROJECT_ID=your-gcp-project-id
BIGQUERY_DATASET=your_dataset_name
BIGQUERY_TABLE=your_bug_table_name

# Mixpanel Configuration
MIXPANEL_API_SECRET=your_mixpanel_api_secret
MIXPANEL_PROJECT_ID=your_mixpanel_project_id
MIXPANEL_SERVICE_ACCOUNT_USERNAME=your_service_account_username
MIXPANEL_SERVICE_ACCOUNT_SECRET=your_service_account_secret

# Anthropic (Claude) API
ANTHROPIC_API_KEY=your_anthropic_api_key

# Gmail Configuration
GMAIL_SENDER_EMAIL=your_email@gmail.com
GMAIL_CREDENTIALS_PATH=/path/to/gmail_credentials.json
GMAIL_TOKEN_PATH=/path/to/gmail_token.json
REPORT_RECIPIENT_EMAILS=recipient1@example.com,recipient2@example.com

# Scheduler Configuration
REPORT_TIME=09:00
TIMEZONE=UTC

# Analysis Configuration
ANALYSIS_LOOKBACK_HOURS=24
